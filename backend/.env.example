# Copy to .env and fill in. NEVER commit the real .env file.

# Required for interviews — free key at console.groq.com
GROQ_API_KEY=gsk_xxxx

# Recommended — raises GitHub API limit to 5,000 req/hour (github.com/settings/tokens)
GITHUB_TOKEN=ghp_xxxx

# Supabase → Settings → Database → connection string.
# Leave unset to use a local SQLite file (fine for Phase 1 dev).
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Phase 3+ (production)
SENTRY_DSN=
FRONTEND_ORIGIN=https://yourdomain.com

# Optional model overrides
GROQ_QUESTION_MODEL=llama-3.1-8b-instant
GROQ_SCORING_MODEL=llama-3.3-70b-versatile
