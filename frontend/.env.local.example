# Copy to .env.local and fill in. NEVER commit the real .env.local.

# Backend API — local dev default; Heroku URL in production (Vercel dashboard)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (Project Settings → API). Leave unset to run without sign-in
# while you finish the Supabase Google OAuth setup.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
